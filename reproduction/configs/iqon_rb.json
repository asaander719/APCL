{
  "dataset": "IQON3000",
  "mode": "RB",
  "seed": 42,
  "batch_size": 512,
  "evaluation_batch_size": 512,
  "epochs": 80,
  "patience": 8,
  "learning_rate": 0.001,
  "weight_decay": 1e-05,
  "lr_decay": 0.97,
  "history_seed": 2026,
  "cpu_threads": 4,
  "model": {
    "hidden_dim": 512,
    "visual_feature_dim": 2048,
    "text_feature_dim": 300,
    "max_sentence": 83,
    "textcnn_layer": 4,
    "with_visual": true,
    "with_text": true,
    "with_Nor": true,
    "cos": true,
    "att": true,
    "b_PC": true,
    "CL": true,
    "use_weighted_loss": false,
    "weight_P": 0.5,
    "uu_w": 3,
    "uu_v_w": 0.5,
    "temperature": 5,
    "w_infoNCE": 0.05,
    "u_pb_num": 2,
    "top_u": 2,
    "with_self_his": false,
    "repeated_interact": false,
    "popular_padding": true,
    "include_indirect_score": false,
    "wide_infer": false,
    "wide_evaluate": false
  }
